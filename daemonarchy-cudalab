#!%%LOCALBASE%%/bin/bash

# omarchy:summary=Open the optional NVIDIA Cudalab studio
# omarchy:args=[demo]
# Open the Cudalab studio on the NVIDIA Linuxulator. The first launch installs
# the CUDA toolkit. An optional argument is a demo name, such as cuda-cosmos.
set -euo pipefail

tool=%%LOCALBASE%%/sbin/daemonarchy-linux-cuda
if [[ ! -x $tool ]]; then
  echo 'Cudalab needs an NVIDIA GPU and the Daemonarchy CUDA setup.' >&2
  exit 1
fi
if [[ $(id -u) != 0 ]]; then
  exec sudo --preserve-env=DISPLAY,XAUTHORITY,XDG_RUNTIME_DIR "$tool" cudalab "$@"
fi
exec "$tool" cudalab "$@"
